@layout TelerikLayout

@inherits LayoutComponentBase

<header class="app-header">
    <nav class="app-header-nav">
        <div class="app-header-inner">
            <NavLink class="app-header-title" href="/" Match="NavLinkMatch.All">Partnership Registration</NavLink>
        </div>
    </nav>
</header>
<div>
    <main role="main" class="pb-3">
        @Body
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; @DateTime.Now.Year - Private Partnerships
    </div>
</footer>